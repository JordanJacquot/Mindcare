<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mindcare" Width="1100" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#09080F"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15" Foreground="#EEEBF7">
  <!-- Le titre de la fenêtre doit rester exactement le nom de l'appli : c'est ainsi que Mindset la trouve pour l'afficher
       dans son onglet. Une autre fenêtre de l'appli (question, chargement) prend un autre titre ou un propriétaire. -->
  <!-- Toutes les couleurs sont celles du thème Néon : themes.ps1 les traduit dans le thème de la suite au chargement. -->
  <Window.Resources>
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#17FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBg" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00E5FF" Offset="0"/><GradientStop Color="#B04BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Boutons pilule de la suite -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBg}"/>
      <Setter Property="Foreground" Value="#08060F"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="Shine" CornerRadius="19" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.65"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Background" Value="#16FFFFFF"/>
      <Setter Property="Foreground" Value="#F2EFFA"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#8000E5FF"/>
          <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00E5FF" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/></Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Une réponse ou une panne à choisir : large, texte à gauche -->
    <Style x:Key="BtnChoix" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="20,12"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <Border x:Name="Shine" CornerRadius="16" IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.65"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shine" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barres de défilement fines et sombres -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#3A3350" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#4A5468"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#00E5FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" Padding="2">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="30"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Carte en verre -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="24,20"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style x:Key="Texte2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#A9A3C9"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Racine">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Fond : nuit violette et trois lueurs (cyan en haut à gauche, violet au centre, magenta en bas à droite) -->
    <Grid Grid.RowSpan="3" IsHitTestVisible="False">
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C0920" Offset="0"/><GradientStop Color="#06050F" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.12,0.05" GradientOrigin="0.12,0.05" RadiusX="0.5" RadiusY="0.55"><GradientStop Color="#4400E5FF" Offset="0"/><GradientStop Color="#0000E5FF" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.6,0.35" GradientOrigin="0.6,0.35" RadiusX="0.45" RadiusY="0.45"><GradientStop Color="#267A3CFF" Offset="0"/><GradientStop Color="#007A3CFF" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.92,0.9" GradientOrigin="0.92,0.9" RadiusX="0.5" RadiusY="0.55"><GradientStop Color="#44FF2EB5" Offset="0"/><GradientStop Color="#00FF2EB5" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
    </Grid>
    <!-- Le décor du thème (themes.ps1) : l'image de fond d'un thème perso, les lignes du Terminal -->
    <Grid x:Name="DecorTheme" Grid.RowSpan="3" IsHitTestVisible="False"/>

    <!-- En-tête : le logo (anneau néon et pouls animé, ou celui du thème perso), le nom, la phrase, la mascotte du thème -->
    <DockPanel Grid.Row="0" Margin="32,26,32,10">
      <Grid Width="52" Height="52" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Image x:Name="LogoPack" Visibility="Collapsed" Width="56" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Grid x:Name="LogoAnneau">
        <Ellipse StrokeThickness="3.5">
          <Ellipse.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00E5FF" Offset="0"/><GradientStop Color="#B04BFF" Offset="0.5"/><GradientStop Color="#FF2EB5" Offset="1"/></LinearGradientBrush></Ellipse.Stroke>
          <Ellipse.Effect><DropShadowEffect Color="#B04BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/></Ellipse.Effect>
        </Ellipse>
        <!-- Le pouls (le logo de Mindcare : un diagnostic) : la ligne en léger, et un trait lumineux qui la parcourt sans fin -->
        <Path Data="M9,27 L18,27 L21,20 L25,35 L29,14 L33,32 L35,27 L43,27" Stroke="#FFFFFF" StrokeThickness="2.5" Opacity="0.45"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path x:Name="Pouls" Data="M9,27 L18,27 L21,20 L25,35 L29,14 L33,32 L35,27 L43,27" Stroke="#FFFFFF" StrokeThickness="2.5"
              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="9 27">
          <Path.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="1"/></Path.Effect>
          <Path.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="36" To="0" Duration="0:0:1.8"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
        </Grid>
      </Grid>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Mindcare" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock x:Name="Phrase" Text="Trouve pourquoi ton PC est en panne, en répondant à quelques questions simples." FontSize="14" Foreground="#A6A1BC" Margin="1,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Le milieu : à gauche la mascotte d'un thème perso et sa bulle (themes.ps1), à droite le contenu (contenu.ps1) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ColMascotte" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid x:Name="MascotteZone" Grid.Column="0" Margin="32,8,0,20" Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel VerticalAlignment="Bottom">
          <Border x:Name="MascotteBulle" HorizontalAlignment="Left" Padding="14,10" Margin="0,0,0,12" CornerRadius="16,16,16,4" Background="#E6110F22" BorderBrush="#7300E5FF" BorderThickness="1">
            <TextBlock x:Name="MascotteTexte" FontSize="14" Foreground="#EEEBF7" TextWrapping="Wrap"/>
          </Border>
          <Border x:Name="Mascotte" HorizontalAlignment="Left"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="Defilement" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="32,8,20,20" Padding="0,0,12,0">
        <StackPanel x:Name="Contenu"/>
      </ScrollViewer>
    </Grid>

    <!-- Le dessin animé du bas d'un thème perso -->
    <Border x:Name="DessinBas" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Left" Margin="32,0,32,8" IsHitTestVisible="False"/>
  </Grid>
</Window>
